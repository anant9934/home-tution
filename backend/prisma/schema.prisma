generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TUTOR
  STUDENT
  PARENT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

// ==========================================
// USERS & ROLES
// ==========================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         Role
  avatarUrl    String?
  isVerified   Boolean  @default(false)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile StudentProfile?
  parentProfile  ParentProfile?
  tutorProfile   TutorProfile?

  notifications Notification[]
  messages      Message[]
  conversations Conversation[] @relation("ConversationParticipants")
  supportTickets SupportTicket[]
}

model StudentProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  class           String
  board           String
  schoolName      String?
  parentId        String?
  parent          ParentProfile? @relation(fields: [parentId], references: [id])
  assignedTutorId String?
  assignedTutor   TutorProfile?  @relation(fields: [assignedTutorId], references: [id])
  dateOfBirth     DateTime?
  joiningDate     DateTime       @default(now())
  address         String?

  bookings         Booking[]
  attendance       Attendance[]
  submissions      Submission[]
  quizAttempts     QuizAttempt[]
  xp               XP[]
  badges           StudentBadge[]
  leaderboardStats Leaderboard[]
  fees             Fee[]
  reviewsGiven     Review[]
  lessonProgress   LessonProgress[]
  assignments      Assignment[]
  quizzes          Quiz[]
}

model ParentProfile {
  id         String  @id @default(uuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation String?
  address    String?

  children StudentProfile[]
}

model TutorProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  experienceYears    Int      @default(0)
  qualification      String?
  hourlyRate         Float    @default(0)
  languages          String[]
  subjects           String[]
  teachingMode       String   @default("BOTH") // ONLINE, HOME, BOTH
  rating             Float    @default(0)
  totalReviews       Int      @default(0)
  isVerified         Boolean  @default(false)
  verificationStatus String   @default("PENDING")
  introVideoUrl      String?

  verificationDoc  TutorVerification?
  studentsAssigned StudentProfile[]
  bookings         Booking[]
  reviewsReceived  Review[]
}

model TutorVerification {
  id                  String       @id @default(uuid())
  tutorId             String       @unique
  tutor               TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  aadhaarDocumentUrl  String
  qualificationDocUrl String
  experienceDocUrl    String?
  status              String       @default("PENDING") // PENDING, APPROVED, REJECTED
  verifiedBy          String? // Admin User ID
  verifiedAt          DateTime?
}

// ==========================================
// LMS (COURSES, CHAPTERS, LESSONS)
// ==========================================

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  subject     String
  class       String
  board       String
  thumbnail   String?
  createdBy   String // Tutor ID
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters    Chapter[]
  assignments Assignment[]
  quizzes     Quiz[]
}

model Chapter {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int

  lessons Lesson[]
}

model Lesson {
  id        String  @id @default(uuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  videoUrl  String?
  notesUrl  String?
  duration  Int // in minutes
  order     Int

  progress  LessonProgress[]
}

model LessonProgress {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean        @default(true)
  createdAt DateTime       @default(now())
  
  @@unique([studentId, lessonId])
}

// ==========================================
// BOOKINGS & SESSIONS
// ==========================================

model Booking {
  id            String         @id @default(uuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])
  tutorId       String
  tutor         TutorProfile   @relation(fields: [tutorId], references: [id])
  bookingType   String // ONE_ON_ONE, GROUP_BATCH
  scheduledAt   DateTime
  duration      Int // in minutes
  status        BookingStatus  @default(PENDING)
  meetingLink   String?
  paymentStatus String         @default("PENDING")

  classSession ClassSession?
}

model ClassSession {
  id               String    @id @default(uuid())
  bookingId        String    @unique
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startedAt        DateTime?
  endedAt          DateTime?
  recordingUrl     String?
  attendanceStatus String? // COMPLETED, MISSED

  attendance Attendance[]
}

model Attendance {
  id             String           @id @default(uuid())
  studentId      String
  student        StudentProfile   @relation(fields: [studentId], references: [id])
  classSessionId String
  session        ClassSession     @relation(fields: [classSessionId], references: [id])
  status         AttendanceStatus
  markedBy       String // Tutor ID
  createdAt      DateTime         @default(now())
}

// ==========================================
// ASSIGNMENTS & QUIZZES
// ==========================================

model Assignment {
  id            String   @id @default(uuid())
  title         String
  description   String?
  courseId      String?
  course        Course?   @relation(fields: [courseId], references: [id])
  studentId     String?
  student       StudentProfile? @relation(fields: [studentId], references: [id])
  createdBy     String
  deadline      DateTime
  maxMarks      Int
  attachmentUrl String?

  submissions Submission[]
}

model Submission {
  id            String         @id @default(uuid())
  assignmentId  String
  assignment    Assignment     @relation(fields: [assignmentId], references: [id])
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])
  submissionUrl String
  submittedAt   DateTime       @default(now())
  marks         Int?
  feedback      String?
}

model Quiz {
  id         String    @id @default(uuid())
  title      String
  courseId   String?
  course     Course?   @relation(fields: [courseId], references: [id])
  studentId  String?
  student    StudentProfile? @relation(fields: [studentId], references: [id])
  duration   Int // in minutes
  totalMarks Int
  createdBy  String
  startTime  DateTime?
  endTime    DateTime?

  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id            String @id @default(uuid())
  quizId        String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText  String
  type          String @default("MCQ")
  options       Json // Array of options
  correctAnswer String
  marks         Int    @default(1)
}

model QuizAttempt {
  id          String         @id @default(uuid())
  quizId      String
  quiz        Quiz           @relation(fields: [quizId], references: [id])
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  score       Int
  startedAt   DateTime       @default(now())
  submittedAt DateTime?
  timeTaken   Int? // in seconds
}

// ==========================================
// GAMIFICATION
// ==========================================

model XP {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  points    Int
  source    String // QUIZ, ATTENDANCE, ASSIGNMENT
  createdAt DateTime       @default(now())
}

model Badge {
  id          String @id @default(uuid())
  name        String
  icon        String
  description String

  earnedBy StudentBadge[]
}

model StudentBadge {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  badgeId   String
  badge     Badge          @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime       @default(now())
}

model Leaderboard {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  week      Int
  month     Int
  points    Int
  rank      Int
}

// ==========================================
// FEES & PAYMENTS
// ==========================================

model Fee {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id])
  amount    Float
  dueDate   DateTime
  status    String         @default("PENDING") // PENDING, PARTIAL, PAID
  month     Int
  year      Int

  payments Payment[]
}

model Payment {
  id             String   @id @default(uuid())
  feeId          String
  fee            Fee      @relation(fields: [feeId], references: [id])
  paymentGateway String   @default("RAZORPAY")
  transactionId  String   @unique
  amount         Float
  status         String   @default("SUCCESS") // PENDING, SUCCESS, FAILED
  paidAt         DateTime @default(now())
}

// ==========================================
// REVIEWS, CHAT & NOTIFICATIONS
// ==========================================

model Review {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id])
  tutorId    String
  tutor      TutorProfile   @relation(fields: [tutorId], references: [id])
  rating     Int
  reviewText String?
  createdAt  DateTime       @default(now())
}

model Conversation {
  id        String   @id @default(uuid())
  type      String   @default("DIRECT") // DIRECT, GROUP
  createdAt DateTime @default(now())

  messages     Message[]
  participants User[]    @relation("ConversationParticipants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  messageText    String?
  attachmentUrl  String?
  seen           Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // ASSIGNMENT, QUIZ, FEE, ANNOUNCEMENT, CLASS
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==========================================
// ANALYTICS
// ==========================================

model DailyStat {
  id               String   @id @default(uuid())
  date             DateTime @unique
  newStudents      Int      @default(0)
  activeStudents   Int      @default(0)
  revenue          Float    @default(0)
  classesCompleted Int      @default(0)
}

model StudentAnalytic {
  id                   String @id @default(uuid())
  studentId            String @unique
  attendancePercentage Float  @default(0)
  quizAverage          Float  @default(0)
  assignmentAverage    Float  @default(0)
  performanceScore     Float  @default(0)
}

// ==========================================
// SUPPORT & TICKETING
// ==========================================

model SupportTicket {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  remarks     String?  // Admin response or resolution notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
